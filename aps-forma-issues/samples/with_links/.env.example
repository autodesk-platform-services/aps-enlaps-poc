# --- aps-ssa (SsaConfig.from_env()) — same as aps-ssa-samples ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_SERVICE_ACCOUNT_ID=
APS_SSA_KEY_ID=
APS_SSA_PRIVATE_KEY_PATH=../secrets/ssa_private_key.pem
APS_BASE_URL=https://developer.api.autodesk.com
APS_SCOPES=data:read data:write data:create account:write account:read
APS_REQUEST_TIMEOUT_SECONDS=15

# --- aps-forma-issues (FormaIssuesConfig.from_env()) ---
ACC_PROJECT_ID=
ACC_UPLOAD_FOLDER_ID=
ACC_BASE_URL=https://developer.api.autodesk.com
REQUEST_TIMEOUT_SECONDS=15

# --- samples-specific — not part of either library's config ---
# The below specified SAMPLE_ISSUE_SUBTYPE_ID has the value for "Safety" issues
SAMPLE_ISSUE_SUBTYPE_ID=dd25b703-f96f-43f6-93ba-5115a6e58c2a
SAMPLE_ASSIGNED_TO=<the-id-of-the-person-that-will-be-assigned-the-ticket>
