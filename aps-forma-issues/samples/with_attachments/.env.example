# --- aps-ssa (SsaConfig.from_env()) — same as aps-ssa-sample ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_SERVICE_ACCOUNT_ID=
APS_SSA_KEY_ID=
APS_SSA_PRIVATE_KEY_PATH=../secrets/ssa_private_key.pem
APS_BASE_URL=https://developer.api.autodesk.com
APS_SCOPES=data:read data:write data:create account:write account:read
APS_REQUEST_TIMEOUT_SECONDS=15

# --- aps-forma-issues (FormaIssuesConfig.from_env()) ---
ACC_PROJECT_ID=
# Still required even for this sample: storage.py's upload call always
# references a folder. Unlike ../aps-forma-issues-sample, this path
# doesn't need Docs folder *permission* on it — any real folder ID in
# the project should work, since the image ends up in an Autodesk
# auto-created folder regardless (see ../aps-forma-issues/README.md).
ACC_UPLOAD_FOLDER_ID=
ACC_BASE_URL=https://developer.api.autodesk.com
REQUEST_TIMEOUT_SECONDS=15

# --- sample-specific — not part of either library's config ---
# A real Issue subtype ID and assignee user ID from the target project;
# there's no sane default since these are project-specific.
SAMPLE_ISSUE_SUBTYPE_ID=
SAMPLE_ASSIGNED_TO=
