# --- 3-legged OAuth (see webapp/auth_service.py) ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REDIRECT_URI=http://localhost:5000/oauth/callback
# account:read is required — without it, resolving assignedTo/ownerId to
# display names via the Account Admin API fails with 403 AUTH-010
# (confirmed live). data:write isn't used for reads but is harmless to keep
# if you also run the other samples against the same APS app.
APS_SCOPE=user-profile:read data:read data:write account:read

# --- aps-forma-issues (FormaIssuesConfig) ---
ACC_PROJECT_ID=
ACC_BASE_URL=https://developer.api.autodesk.com
REQUEST_TIMEOUT_SECONDS=15

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-value
FLASK_DEBUG=1
PORT=5000
